# Multi-stage production build for the standalone ground-staff Agent app
# (src/agent) — a wholly separate Next.js app from admin/frontend, sub-linked
# rather than merged into the admin panel. Mirrors devops/Dockerfile.admin's
# convention exactly (same build-context-at-repo-root pattern).
FROM node:20-alpine AS builder
WORKDIR /app
COPY src/agent/package*.json ./
RUN npm ci
COPY src/agent/ .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

# next.config.js has output: 'standalone', so the runner only needs the
# traced standalone server + static assets — not the full node_modules tree.
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
