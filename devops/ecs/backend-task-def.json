{
  "family": "ziyam-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::042522372467:role/ziyam-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::042522372467:role/ziyam-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "042522372467.dkr.ecr.eu-north-1.amazonaws.com/ziyam-backend:latest",
      "portMappings": [{ "containerPort": 5000, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "5000" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "CLIENT_URL", "value": "https://ziyam.in" },
        { "name": "SERVER_URL", "value": "https://api.ziyam.in" },
        { "name": "ADMIN_URL", "value": "https://admin.ziyam.in" },
        { "name": "JWT_EXPIRES_IN", "value": "30d" },
        { "name": "AI_MODEL", "value": "claude-haiku-4-5-20251001" },
        { "name": "PAYMENT_PROVIDER", "value": "payu" },
        { "name": "PAYU_MODE", "value": "live" },
        { "name": "PLATFORM_COMMISSION_PERCENTAGE", "value": "0.30" },
        { "name": "HOST_PAYOUT_PERCENTAGE", "value": "0.70" },
        { "name": "PAYOUT_SETTLEMENT_HOURS", "value": "24" },
        { "name": "KYC_PROVIDER", "value": "digilocker" },
        { "name": "SANDBOX_MODE", "value": "live" },
        { "name": "SETU_MODE", "value": "live" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/database-url::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/jwt-secret::" },
        { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/anthropic-api-key::" },
        { "name": "PAYU_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/payu-key::" },
        { "name": "PAYU_SALT", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/payu-salt::" },
        { "name": "PAYMENT_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/payment-webhook-secret::" },
        { "name": "KYC_API_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/kyc-api-key::" },
        { "name": "SANDBOX_API_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/sandbox-api-key::" },
        { "name": "SANDBOX_API_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/sandbox-api-secret::" },
        { "name": "SETU_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/setu-client-id::" },
        { "name": "SETU_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/setu-client-secret::" },
        { "name": "SETU_DIGILOCKER_PRODUCT_INSTANCE_ID", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/setu-digilocker-instance-id::" },
        { "name": "SETU_ESIGN_PRODUCT_INSTANCE_ID", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/setu-esign-instance-id::" },
        { "name": "TELEMATICS_GATEWAY_URL", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/telematics-gateway-url::" },
        { "name": "TELEMATICS_API_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:042522372467:secret:ziyam/backend-secrets-zKlPhm:ziyam/telematics-api-key::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ziyam-backend",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "backend",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:5000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
