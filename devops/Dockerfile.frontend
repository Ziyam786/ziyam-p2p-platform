# Multi-stage production build for the renter/host Next.js app (src/frontend).
# Build context is the repo root (matches devops/Dockerfile's convention) so
# this can be built the same way from docker-compose or CI either way.
# NEXT_PUBLIC_* vars are baked into the client bundle at build time, not read
# at container start — they must be passed as --build-arg, not just env_file.
FROM node:20-alpine AS builder
WORKDIR /app
COPY src/frontend/package*.json ./
RUN npm ci
COPY src/frontend/ .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
RUN npm run build

# next.config.js has output: 'standalone', so the runner only needs the
# traced standalone server + static assets — not the full node_modules tree.
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
