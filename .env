# --- Database ---
DATABASE_URL="postgresql://user:password@localhost/ziyam_db"

# --- App ---
PORT=5000
CLIENT_URL="http://localhost:3000"
NODE_ENV=development

# --- Payments (Stripe Connect / Razorpay Route / Cashfree) ---
PAYMENT_PROVIDER=razorpay
PAYMENT_API_KEY="test_key_local"
PAYMENT_API_SECRET="test_secret_local"
PAYMENT_WEBHOOK_SECRET="test_webhook_secret"

# --- Payout policy ---
PLATFORM_COMMISSION_PERCENTAGE=0.30
HOST_PAYOUT_PERCENTAGE=0.70
PAYOUT_SETTLEMENT_HOURS=24

# --- KYC ---
KYC_PROVIDER=digilocker
KYC_API_KEY="test_kyc_key"

# --- Telematics / IoT ---
TELEMATICS_GATEWAY_URL="https://api.telematics-provider.com/v1"
TELEMATICS_API_KEY="test_telematics_key"

# --- Redis (queues / caching) ---
REDIS_URL="redis://localhost:6379"
