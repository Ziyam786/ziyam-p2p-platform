datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/glibc Linux); the musl-openssl-3.0.x
  // target is required for the devops/Dockerfile's node:20-alpine image, whose
  // Alpine base ships OpenSSL 3.x rather than the 1.1.x Prisma's default musl
  // engine expects — without this, the container crash-loops on startup with
  // "Error loading shared library libssl.so.1.1: No such file or directory".
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  SELF_HOST
  FLEET_OPERATOR // external business managing multiple owners' cars; self-signup-able (see signup/page.tsx)
  AGENT
  // Internal Eightlines ops staff (Fleet Ops Admin Dashboard) — admin-provisioned only,
  // never in the public signup role picker. Coarse-gated by requireRole(); fine-grained
  // per-screen access comes from the orthogonal CustomRole.permissions layer below.
  FLEET_ADMIN
  OPERATIONS_EXECUTIVE
  MECHANICAL_EXECUTIVE
  TECHNICIAN
  ADMIN
}

// Granular "Who Can Do What" screen-level permissions for internal Ops/Finance staff —
// orthogonal to the coarse Role enum above. A User optionally has one CustomRole
// (User.customRoleId); requirePermission(screen) middleware checks
// user.customRole.permissions[screen] === true, loaded fresh per-request since the JWT
// itself only carries {userId, role}. ADMIN always passes regardless of CustomRole.
// The 9 permission keys mirror the real Financial ERP's PERM_LABELS exactly: dashboard,
// earnings, collections, expenses, outstandings, balanceSheet, plStatement, config, roles.
model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json // { dashboard: bool, earnings: bool, collections: bool, expenses: bool, outstandings: bool, balanceSheet: bool, plStatement: bool, config: bool, roles: bool }
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  RESERVED // reservation fee paid, balance due within reservationDeadline (see booking.routes.ts)
  PENDING_HOST_REVIEW // balance paid, awaiting host accept/reject (see hostReview.routes.ts)
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED // host (or review-window timeout) declined — always a full refund, see refund-policy §5
}

enum CancelledBy {
  CUSTOMER
  HOST
  SYSTEM // host-review timeout
  ADMIN
}

enum TripStage {
  PRE_TRIP
  POST_TRIP
}

enum PhotoAngle {
  FRONT
  REAR
  LEFT
  RIGHT
  MIRROR_LEFT
  MIRROR_RIGHT
  ODOMETER
  OTHER
}

enum KycMethod {
  AADHAAR_OTP
  DIGILOCKER
  DOC_UPLOAD
}

enum KycOutcome {
  SUCCESS
  FAILED
}

enum BookingDepositStatus {
  HELD // charged via PayU with the trip cost, awaiting the report window
  RELEASED // report window passed with no claim -> RefundRequest created for admin
  PARTIALLY_DEDUCTED // a DamageClaim was approved for less than the full deposit
  FORFEITED // a DamageClaim was approved for >= the full deposit
}

enum DamageClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum RefundRequestType {
  DEPOSIT_RELEASE
  DEPOSIT_PARTIAL
  CANCELLATION // guest cancel or host reject/timeout, see booking.routes.ts and hostReview.routes.ts
}

enum RefundRequestStatus {
  PENDING
  COMPLETED
}

enum PayoutStatus {
  HELD_IN_ESCROW
  QUEUED_FOR_N1
  SETTLED
  FAILED
}

enum CarVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// --- Fleet Financial Dashboard & Ledger System (see PRD: fleet_dashboard_tech_spec_v2) ---
// platform/category/expenseType/paymentMode on PlatformBooking/JournalEntry/
// FleetExpense are plain Strings, not enums — admin-configurable via the
// fleet_platforms/fleet_ledger_categories/fleet_expense_types/fleet_payment_modes
// Settings (same row-editor pattern as protection_plans), matching the real
// Financial ERP's "configurable, add/remove" categories requirement. The
// values below (originally this Postgres enum's values) seed those Settings'
// defaults in settingsService.ts.

enum ServiceRequestStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id                  String    @id @default(uuid())
  fullName            String
  email               String    @unique
  phoneNumber         String    @unique
  passwordHash        String
  // Account lockout after repeated failed logins — reset to 0/null on any
  // successful login. See MAX_FAILED_ATTEMPTS / LOCKOUT_DURATION_MS in
  // auth.routes.ts.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  avatarUrl           String?
  bio                 String?
  role                Role      @default(CUSTOMER)
  isKycVerified       Boolean   @default(false)
  isSuspended         Boolean   @default(false)
  kycDocUrl           String?
  payoutAccountId     String? // Linked Razorpay Route / Stripe Connect sub-account

  // Sandbox (sandbox.co.in) Aadhaar eKYC + bank penny-drop verification
  aadhaarVerifiedName String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankNameAtBank      String?
  bankAccountVerified Boolean @default(false)

  // Extended verification checklist (matches host-app profile: signature for
  // lease agreements, alternate contact, liveness selfie)
  signatureUrl         String?
  selfieUrl            String?
  alternatePhoneNumber String?

  // Setu DigiLocker KYC (OAuth-style consent redirect — see setuService.ts)
  digilockerRequestId String?
  digilockerStatus    String? // unauthenticated | authenticated

  // Refer & Earn
  referralCode   String? @unique // backfilled lazily on first login post-migration; new signups always get one
  referredById   String?
  referredBy     User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]  @relation("Referrals")
  creditsBalance Float   @default(0)

  // Self-hosted payout cadence preference (fleet-managed cars ignore this —
  // see Car.fleetManaged / the N+1 policy split in payoutEngine.ts)
  payoutFrequency String @default("STANDARD") // STANDARD (24-48hr after trip) | WEEKLY

  // Internal Ops/Finance granular permissions (see CustomRole doc comment above)
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])

  // Fleet-partner identity extras (maps the Fleet Ops "owners" table onto this
  // existing User rather than a separate Owner model — bank fields already exist above)
  ownerCode String?

  // Aug-2024 policy: payout eligibility requires BOTH signatures on the Partner
  // Agreement — distinct from signatureUrl (a general reusable lease-agreement
  // signature) and from Booking's per-trip Setu eSign fields. Computed at
  // check-time in the Ops payout-release route, never persisted as a boolean:
  // payoutEligible = Boolean(partnerAgreementWetSignedUrl) && partnerAgreementEsignStatus === 'sign_complete'
  partnerAgreementWetSignedUrl     String?
  partnerAgreementWetSignedAt      DateTime?
  partnerAgreementEsignRequestId   String?
  partnerAgreementEsignStatus      String? // sign_initiated | sign_pending | sign_in_progress | sign_complete
  partnerAgreementEsignDownloadUrl String?

  cars                    Car[]
  fleetManagedCars        Car[]             @relation("FleetOperatorCars")
  bookings                Booking[]         @relation("CustomerBookings")
  payouts                 PayoutLedger[]
  reviewsWritten          Review[]          @relation("ReviewAuthor")
  reviewsReceived         Review[]          @relation("ReviewTarget")
  wishlist                Wishlist[]
  notifications           Notification[]
  loggedPlatformBookings  PlatformBooking[]
  loggedJournalEntries    JournalEntry[]
  loggedFleetExpenses     FleetExpense[]
  requestedServices       ServiceRequest[]
  assignedServiceRequests ServiceRequest[]  @relation("AgentServiceRequests")
  loggedOpsTrips          OpsTrip[]
  assignedOpsTrips        OpsTrip[]         @relation("AgentOpsTrips")
  reportedDamageClaims    DamageClaim[]     @relation("ReportedDamageClaims")
  reviewedDamageClaims    DamageClaim[]     @relation("ReviewedDamageClaims")
  completedRefundRequests RefundRequest[]   @relation("CompletedRefundRequests")
  conditionPhotosUploaded BookingConditionPhoto[]
  kycVerificationLogs     KycVerificationLog[]
  loggedCashLogEntries    CashLogEntry[]
  loggedOpsInvoices       OpsInvoice[]
  loggedOpsPayments       OpsPayment[]
  loggedOutstandings      Outstanding[]
  messagesSent            Message[]
  pushTokens              PushToken[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// One-time passcodes for phone-based login (guest + host — same login is
// role-agnostic). Not tied to a User by foreign key on purpose: a request
// must succeed even before we've decided whether to reveal that the phone
// number has an account (see /auth/otp/request).
model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
}

// Per-attempt KYC history — kyc.routes.ts writes one row per terminal
// outcome (success or failure) on each of the three verification paths.
// Distinct from the User's current isKycVerified/aadhaarVerifiedName/
// digilockerStatus snapshot fields: this is the append-only timeline behind
// that snapshot, so an admin can see every attempt, not just the latest one.
model KycVerificationLog {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  method    KycMethod
  outcome   KycOutcome
  detail    String? // verified name on success, error message on failure
  createdAt DateTime   @default(now())

  @@index([userId])
}

model Car {
  id               String   @id @default(uuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  make             String
  model            String
  registrationNo   String   @unique
  year             Int
  category         String // Hatchback, Sedan, SUV, Luxury, EV, MUV
  fuelType         String // PETROL, DIESEL, EV
  transmission     String // MANUAL, AUTOMATIC
  seats            Int      @default(5)
  dailyRate        Float
  securityDeposit  Float    @default(3000)
  kmIncludedPerDay Int      @default(300)
  extraKmCharge    Float    @default(10)
  description      String?
  images           String[] @default([])
  // Admin-only unblurred originals, same array index as `images` (images[i]
  // is the public/blurred version of originalImages[i]) — used to verify a
  // listing's photo genuinely matches its registrationNo. Never exposed on
  // any public-facing route.
  originalImages   String[] @default([])
  features         String[] @default([])
  city             String
  address          String?
  latitude         Float?
  longitude        Float?
  isAvailable      Boolean  @default(true)
  instantBook      Boolean  @default(true)
  featured         Boolean  @default(false)
  offersDelivery   Boolean  @default(false)
  deliveryFee      Float    @default(0)
  offersPickup     Boolean  @default(false)
  pickupFee        Float    @default(0)
  telematicsImei   String?

  // Ziyam Yield — when true, the weekly cron (yieldEngine.ts) applies the
  // computed price suggestion to dailyRate automatically; when false (the
  // default), the host sees the suggestion on their dashboard and applies
  // it manually, or ignores it. Never silent unless the host opted in.
  yieldAutoApply Boolean @default(false)

  // Fleet-operator management opt-in — when set, N+1 payouts route through the
  // fleet operator's receipt-confirmation step instead of the standard
  // self-hosted 24-48hr/weekly cadence (see payoutEngine.ts)
  fleetManaged    Boolean @default(false)
  fleetOperatorId String?
  fleetOperator   User?   @relation("FleetOperatorCars", fields: [fleetOperatorId], references: [id])

  // 4-step Fleet Partner Onboarding journey (Audit -> Security -> Agreement ->
  // Go Live). 0 = not started/opted in. 1 = audit submitted, fleet operator
  // assigned via random "finger-crossed" shuffle. 2 = security/telematics
  // confirmed (Car.telematicsImei set). 3 = awaiting partnership agreement —
  // an admin/fleet_admin manually advances to Go Live (fleetManaged=true)
  // once it's actually signed. Per-car (not per-User like
  // partnerAgreementWetSignedUrl below) since a host can have some
  // fleet-managed and some self-hosted cars — this is the *additional*
  // fleet-specific agreement layered on top of every host's one-time
  // Host Onboarding Agreement, not a replacement for it.
  fleetOnboardingStep            Int       @default(0)
  fleetAgreementWetSignedUrl     String?
  fleetAgreementWetSignedAt      DateTime?
  fleetAgreementEsignRequestId   String?
  fleetAgreementEsignStatus      String? // sign_initiated | sign_pending | sign_in_progress | sign_complete
  fleetAgreementEsignDownloadUrl String?

  // Onboarding / verification (RC, pollution cert, insurance) — see host/onboarding/car wizard
  verificationStatus CarVerificationStatus @default(PENDING)
  rcDocUrl           String?
  pollutionCertUrl   String?
  insuranceDocUrl    String?
  onboardingStep     Int                   @default(0) // 0-4, drives the "Steps Completed" progress ring

  // Fleet Ops internal asset-record fields (merged in from the standalone Fleet Ops
  // Admin Dashboard — same physical vehicle, since it earns revenue across multiple
  // channels including this platform's own "Ziyam Direct" listing).
  vehicleCode          String?
  chassis              String?
  currentOdo           Float?
  lastServiceOdo       Float?
  lastServiceDate      DateTime?
  serviceScheduledDate DateTime?
  insuranceExpiry      DateTime?
  rcExpiry             DateTime?
  pucExpiry            DateTime?
  fuelLevel            Float?

  // Ops pause/service state — mirrors the real production system exactly (ground-
  // truthed from the live app's source, not the marketing doc's richer-sounding
  // "Awaiting/Pending/Approved/Rejected" 4-state description): fleetStatus is only
  // ever 'active' or 'paused'; pauseReason disambiguates *why* — 'personal' (owner-
  // requested, needs admin approval via pauseStatus) or 'service' (ops-initiated,
  // no approval step, cleared automatically when the mechanic logs the service).
  // pauseStatus is null once approved (status='paused' IS the "approved" state) —
  // there's no separate "approved" string in the real system.
  fleetStatus String    @default("active") // active | paused
  pauseReason String? // personal | service
  pauseStatus String? // pending | rejected (null once approved, or when not personal)
  pauseFrom   DateTime?
  pauseUntil  DateTime?

  // Booking preferences (host-controlled)
  noNightBookings      Boolean @default(false)
  nightBookingStart    String  @default("22:00")
  nightBookingEnd      String  @default("06:00")
  minInterBookingHours Int     @default(2)
  minBookingHours      Int     @default(4)
  maxBookingDays       Int     @default(30)

  bookings         Booking[]
  reviews          Review[]
  blackouts        Blackout[]
  wishlistedBy     Wishlist[]
  platformBookings PlatformBooking[]
  journalEntries   JournalEntry[]
  fleetExpenses    FleetExpense[]
  serviceRequests  ServiceRequest[]
  opsTrips         OpsTrip[]
  createdAt        DateTime          @default(now())

  // city+isAvailable covers the public car search (the highest-traffic read
  // path in the app — nearly every listing query filters on both); ownerId
  // covers the host dashboard's "my cars" — Postgres doesn't auto-index FK
  // columns the way some other databases do.
  @@index([city, isAvailable])
  @@index([ownerId])
  @@index([fleetOperatorId])
}

// Date ranges a host manually blocks off (maintenance, personal use, etc.) —
// checked alongside existing bookings when validating a new booking's dates.
model Blackout {
  id        String   @id @default(uuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([carId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, carId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // BOOKING_CONFIRMED | TRIP_STARTED | REVIEW_RECEIVED | KYC_VERIFIED | PAYOUT_SETTLED | PROMO | GENERIC
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// FCM device/browser tokens — a user can have several (multiple browsers/
// devices). notify() (notificationService.ts) fans out to every real
// notification here via pushNotificationService.ts, best-effort — a push
// failure never blocks the in-app Notification row above from being created.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  platform   String? // web | ios | android
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

model Booking {
  id                    String        @id @default(uuid())
  carId                 String
  car                   Car           @relation(fields: [carId], references: [id])
  customerId            String
  customer              User          @relation("CustomerBookings", fields: [customerId], references: [id])
  startTime             DateTime
  endTime               DateTime
  totalAmount           Float
  platformFee           Float
  hostPayoutAmount      Float
  protectionPlan        String        @default("BASIC") // BASIC, STANDARD, PREMIUM
  deliveryRequested     Boolean       @default(false)
  // Snapshot of Car.deliveryFee at booking time (mutable on Car, so this is
  // pinned the same way depositAmount pins Car.securityDeposit). Passed
  // through 100% to whoever drives the car over — excluded from platform
  // commission in PayoutEngine.splitAmount, since the platform doesn't do
  // the driving.
  deliveryFeeAmount     Float         @default(0)
  // Flat ₹500 add-on — a second named driver covered on the trip. Name +
  // license are required together whenever this is set, since an unnamed
  // co-driver isn't actually covered by the host's insurance or the lease
  // agreement.
  coDriverRequested     Boolean       @default(false)
  coDriverName          String?
  coDriverLicenseNumber String?
  promoCode             String?
  status                BookingStatus @default(PENDING)
  // 4-digit code generated when the trip starts; shown only to the host and
  // must be supplied by whoever completes the trip — proves the handover
  // actually happened in person rather than either side just tapping "done".
  endOtp                String?

  // Security deposit — charged in the same PayU transaction as totalAmount
  // (see booking.routes.ts), not a separate hold. depositAmount is a snapshot
  // of Car.securityDeposit at booking time, reduced per protectionPlan.
  depositAmount     Float                @default(0)
  depositStatus     BookingDepositStatus @default(HELD)
  depositReleasedAt DateTime?

  // Two-stage checkout — guest pays this small fee first (see
  // POST /booking/:id/checkout-session), reviews everything with the dates
  // genuinely held, then pays the rest via /balance-checkout-session within
  // reservationDeadline. 10% of totalAmount, min ₹299 — computed server-side
  // at booking creation, same tamper-proof pattern as depositAmount.
  reservationFeeAmount Float     @default(0)
  reservationPaidAt    DateTime?
  reservationDeadline  DateTime? // reservationPaidAt + 24h; auto-cancel cron watches this (payoutEngine.ts)

  damageClaim       DamageClaim?
  refundRequests    RefundRequest[]
  conditionPhotos   BookingConditionPhoto[]

  // Late-return fee — charged automatically at /complete when the trip ends
  // more than the grace period past endTime (see LATE_FEE_GRACE_HOURS in
  // booking.routes.ts). Real, published in terms/page.tsx §5 ("late fees")
  // but never actually computed anywhere until now. Recovered by reducing
  // what the deposit-release cron pays back, same mechanism a DamageClaim
  // uses — not a new live payment charge.
  lateFeeAmount Float @default(0)
  lateFeeHours  Float @default(0)

  // Live doorstep-delivery tracking (Uber/Zepto-style) — the host's own
  // device reports its GPS position via POST /bookings/:id/delivery-location
  // while driving the car to the guest; only meaningful when
  // deliveryRequested is true and only shown to the guest pre-pickup.
  // Last-known-position only, not a route history — a new model would be
  // overkill for "where is the car right now."
  deliveryLatitude          Float?
  deliveryLongitude         Float?
  deliveryLocationUpdatedAt DateTime?

  // Host review — inserted between payment success and CONFIRMED (see
  // hostReview.routes.ts). hostReviewDeadline drives the auto-reject cron in
  // payoutEngine.ts once the review window (host_review_window_hours setting)
  // elapses with no host response.
  hostReviewDeadline DateTime?
  rejectionReason    String?
  cancellationReason String?
  cancelledBy        CancelledBy?

  // Set by the fleet operator once they've confirmed receiving a clear payout
  // from the platform for this booking — starts the 1-day host payout window
  // for fleet-managed cars (Car.fleetManaged)
  fleetReceiptConfirmedAt DateTime?

  // Setu Aadhaar eSign — real e-signing of the generated lease agreement PDF
  // (see setuService.ts + fleetLedger-adjacent /bookings/:id/esign routes)
  esignRequestId   String?
  esignStatus      String? // sign_initiated | sign_pending | sign_in_progress | sign_complete
  esignDownloadUrl String?
  paymentIntentId  String?
  payoutLedger     PayoutLedger?
  review           Review?
  serviceRequests  ServiceRequest[]
  messages         Message[]
  createdAt        DateTime         @default(now())

  // carId+status covers the overlap check every new booking runs; customerId
  // covers "my trips" — both previously unindexed despite being the most
  // heavily filtered fields in the app.
  @@index([carId, status])
  @@index([customerId])
}

// A host's report of trip damage against a completed booking's security
// deposit — one per booking (1:1; amend via adminNotes rather than filing a
// second claim). Replaces the old "contact support" advisory-only flow.
model DamageClaim {
  id                String            @id @default(uuid())
  bookingId         String            @unique
  booking           Booking           @relation(fields: [bookingId], references: [id])
  reportedById      String
  reportedBy        User              @relation("ReportedDamageClaims", fields: [reportedById], references: [id])
  description       String
  images            String[]          @default([])
  estimatedCost     Float
  status            DamageClaimStatus @default(SUBMITTED)
  // Set by the reviewing admin on APPROVED/REJECTED — the actual amount
  // deducted from the deposit, which may be less than estimatedCost.
  approvedDeduction Float?
  adminNotes        String?
  reviewedByAdminId String?
  reviewedByAdmin   User?             @relation("ReviewedDamageClaims", fields: [reviewedByAdminId], references: [id])
  createdAt         DateTime          @default(now())
  resolvedAt        DateTime?

  @@index([status])
}

// Money owed back to a guest that a human admin must action manually in the
// PayU merchant portal — no live refund API integration yet. Covers deposit
// releases/partial releases, and CANCELLATION (guest cancel or host
// reject/timeout — see booking.routes.ts and hostReview.routes.ts).
model RefundRequest {
  id                 String              @id @default(uuid())
  bookingId          String
  booking            Booking             @relation(fields: [bookingId], references: [id])
  type               RefundRequestType
  amount             Float
  status             RefundRequestStatus @default(PENDING)
  notes              String?
  completedByAdminId String?
  completedByAdmin   User?               @relation("CompletedRefundRequests", fields: [completedByAdminId], references: [id])
  createdAt          DateTime            @default(now())
  completedAt        DateTime?

  @@index([status])
}

// Pickup (PRE_TRIP) and drop-off (POST_TRIP) vehicle-condition photos — one
// row per angle. Required before /booking/:id/start and /booking/:id/complete
// respectively (front/rear/left/right), so they're usable evidence in a
// damage dispute rather than an optional, skippable extra. uploadedBy is
// whichever party (host or guest) actually took the photo — either can, same
// as today's Start Trip button having no host-only restriction.
model BookingConditionPhoto {
  id           String     @id @default(uuid())
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id])
  stage        TripStage
  angle        PhotoAngle
  url          String
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([bookingId])
}

// Guest<->host messaging, scoped to a specific booking (not a general DM
// system) — pickup coordination, pre-trip questions, etc. senderId is
// whichever of the booking's two parties sent it; the other party is always
// the recipient, so no separate recipientId column is needed.
model Message {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model PayoutLedger {
  id           String       @id @default(uuid())
  bookingId    String       @unique
  booking      Booking      @relation(fields: [bookingId], references: [id])
  hostId       String
  host         User         @relation(fields: [hostId], references: [id])
  grossAmount  Float
  ziyamCut     Float
  netPayout    Float
  status       PayoutStatus @default(HELD_IN_ESCROW)
  scheduledFor DateTime // Trip completion + N hours
  payoutTxnId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id])
  carId        String
  car          Car      @relation(fields: [carId], references: [id])
  authorId     String
  author       User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetHostId String
  targetHost   User     @relation("ReviewTarget", fields: [targetHostId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  // Admin soft-moderation — hides a review from all public listings without
  // destroying it, unlike delete. Preferred for disputed/reported reviews so
  // there's still a record if the host/renter contests the moderation later.
  hidden Boolean @default(false)

  // Both filtered on constantly for rating aggregation — every car listing
  // and every host profile queries one of these on nearly every page load.
  @@index([carId, hidden])
  @@index([targetHostId, hidden])
}

// Admin-managed discount codes, applied by renters at checkout.
model PromoCode {
  code            String    @id
  discountPercent Float? // e.g. 0.10 for 10% off
  discountFlat    Float? // flat rupee amount off, alternative to percent
  maxUses         Int? // null = unlimited
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

// Generic key/value CMS + platform-config store, edited from the admin app.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// AI support chatbot transcript, keyed by a client-generated session id.
model ChatLog {
  id        String   @id @default(uuid())
  sessionId String
  userId    String?
  role      String // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// Revenue log for a trip booked through an external rental channel (or Marc8
// itself) rather than through this platform's own Booking flow — lets a fleet
// operator reconcile earnings across every platform their cars are listed on.
model PlatformBooking {
  id                 String    @id @default(uuid())
  carId              String
  car                Car       @relation(fields: [carId], references: [id])
  platform           String // Zoomcar | Revv | Bharat | Marc8 | etc — see fleet_platforms Setting
  externalBookingId  String    @unique
  bookedAt           DateTime
  totalFare          Float
  doorstepCharges    Float     @default(0)
  platformCommission Float?
  // Ground-truthed parity fields from the real "earnings" table — gates when a
  // booking counts as credited revenue for Command Center cash-position math.
  received           Boolean   @default(false)
  expectedCreditDate DateTime?
  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())

  @@index([carId])
  @@index([platform])
}

// Offline reconciliation / settlement voucher (cash collected on the ground,
// toll top-ups, damage recovery, etc.) — the "Journal Entry" ledger.
model JournalEntry {
  id              String   @id @default(uuid())
  collectionDate  DateTime
  carId           String
  car             Car      @relation(fields: [carId], references: [id])
  amountCollected Float
  totalAmount     Float
  category        String // see fleet_ledger_categories Setting
  remarks         String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@index([carId])
  @@index([category])
}

// General fleet overhead (maintenance, insurance, permits, salaries, etc.).
// carId is nullable — null means "Fleet-Wide" per the PRD.
model FleetExpense {
  id             String          @id @default(uuid())
  expenseType    String // see fleet_expense_types Setting
  carId          String?
  car            Car?            @relation(fields: [carId], references: [id])
  paymentMode    String // see fleet_payment_modes Setting
  paidTo         String?
  amount         Float
  date           DateTime
  description    String?
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  serviceRequest ServiceRequest?
  createdAt      DateTime        @default(now())

  @@index([carId])
  @@index([expenseType])
}

enum OutstandingType {
  RECEIVABLE // owed TO the platform (e.g. a platform hasn't yet paid out a trip)
  PAYABLE // owed BY the platform (e.g. an owner payout not yet transferred)
}

enum OutstandingStatus {
  PENDING
  PAID
}

// Ground-truthed exact cadence options from the real Financial ERP's recurring-
// entry UI copy.
enum OutstandingFrequency {
  ONCE
  EVERY_TRIP
  EVERY_MONTH
  EVERY_DUE
  EVERY_PAYMENT
  EVERY_COLLECTION
}

// Receivables & Payables ledger — merged in from the Financial ERP's
// "outstandings" table. sourceType is free-text descriptive copy (e.g. "A
// Trip", "A Direct Collection", "A Due We Owe", "A Payment We Made" in the
// real app) rather than a rigid enum, since it's UI classification text, not
// something the app branches on structurally — type/status/frequency are the
// fields that actually drive balance-sheet math and are real enums.
model Outstanding {
  id              String               @id @default(uuid())
  expectedDate    DateTime
  paymentTo       String
  amountOwed      Float
  outstandingType OutstandingType
  sourceType      String?
  frequency       OutstandingFrequency @default(ONCE)
  recurringGroup  String?
  status          OutstandingStatus    @default(PENDING)
  paidDate        DateTime?
  createdById     String
  createdBy       User                 @relation(fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())

  @@index([outstandingType])
  @@index([status])
}

// Monthly opening/closing cash balance roll-up for the Command Center /
// Monthly Cash Ledger view. month is a "YYYY-MM" string key, matching the real
// system's PK exactly — this is a computed/scheduled roll-up rather than a
// manually-entered transaction, so (unlike every other ledger model here) it
// has no createdById attribution field.
model MonthlyBalance {
  month          String   @id
  openingBalance Float
  closingBalance Float?
  createdAt      DateTime @default(now())
}

// Host-requested vehicle maintenance/servicing (matches the "Vehicle Services"
// booking screen). Completing a request auto-logs a FleetExpense so the
// financial ledger stays in sync without manual double-entry.
model ServiceRequest {
  id              String               @id @default(uuid())
  carId           String
  car             Car                  @relation(fields: [carId], references: [id])
  requestedById   String
  requestedBy     User                 @relation(fields: [requestedById], references: [id])
  serviceType     String // "Basic Service" | "Standard Services" | "Washing" | custom
  priceEstimate   Float
  scheduledDate   DateTime
  serviceLocation String
  status          ServiceRequestStatus @default(REQUESTED)
  notes           String?
  fleetExpenseId  String?              @unique
  fleetExpense    FleetExpense?        @relation(fields: [fleetExpenseId], references: [id])

  // Guest-initiated add-ons (e.g. washing) tied to a specific trip rather
  // than a host's own maintenance request — auto-assigned to an agent below.
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])
  assignedAgentId String?
  agent           User?    @relation("AgentServiceRequests", fields: [assignedAgentId], references: [id])

  // Fleet Ops Maintenance Hub fields (merged in from the standalone dashboard) —
  // cost breakdown, technician assignment, and per-job invoice details. The real
  // production app writes status='completed' on every insert (no scheduling/
  // in-progress states are actually wired up), so ServiceRequestStatus's
  // existing REQUESTED/CONFIRMED/COMPLETED/CANCELLED set is left as-is rather
  // than widened for workflow states nothing currently uses.
  serviceCategory String?
  labourCost      Float?
  partsCost       Float?
  totalCost       Float?
  technician      String?
  mechanicNotes   String?
  odometer        Float?
  serviceCode     String?
  invoiceBillTo   String?
  invoiceMobile   String?
  invoiceDate     DateTime?
  items           ServiceRequestItem[]
  opsInvoices     OpsInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId])
  @@index([bookingId])
  @@index([assignedAgentId])
}

model ServiceRequestItem {
  id        String         @id @default(uuid())
  serviceId String
  service   ServiceRequest @relation(fields: [serviceId], references: [id])
  itemName  String
  price     Float?
  note      String?
  createdAt DateTime       @default(now())

  @@index([serviceId])
}

enum OpsTripStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

// Fleet Ops trip check-in/check-out lifecycle, merged in from the standalone
// Fleet Ops Admin Dashboard — trips sourced from external platforms (Zoomcar,
// Revv, Bharat) or manually logged by ops staff for a walk-in/direct customer.
// Deliberately kept separate from Booking: Booking is a renter's own PayU/KYC
// self-checkout through this platform's own N+1 PayoutLedger engine; OpsTrip is
// front-desk-staff-logged with no renter account at all (customerName/Mobile
// are plain strings, no User FK — that's a real data-model incompatibility
// with Booking.customerId, not just a workflow-preference one). addons /
// checkoutAddons are stored as JSON to match the real production system
// exactly (denormalized on the row, not a relational child table) — real addon
// type literals in use: Toll packages, Co-Driver, Driver, Night Driver, Driver
// food and accommodation, Unlimited kms, Fuel Package, Airport Pickup, Airport
// Drop, Waiting Charges, Car doorstep, Full Car Washing, Interior/Exterior
// Cleaning only, DAMAGES, other.
model OpsTrip {
  id                String  @id @default(uuid())
  tripCode          String?
  carId             String
  car               Car     @relation(fields: [carId], references: [id])
  bookingPlatform   String? // Zoomcar | Revv | Bharat | Ziyam Direct | etc — see fleet_platforms Setting
  externalBookingId String? // the source platform's own booking reference, if any
  driverRef         String?

  customerName   String
  customerMobile String
  pickupLocation String?
  dropLocation   String?
  pickupType     String? // e.g. Airport Pickup/Drop, Doorstep, Self

  startTime DateTime
  endTime   DateTime?

  odometerStart  Float?
  odometerEnd    Float?
  rangeKm        Float?
  fastag         String?
  checkoutFastag String?
  fuelEst        String?
  carWashed      Boolean @default(false)
  washingCharges Float?
  tyreHealth     String?
  newDamages     String?

  baseFare        Float?
  addonTotal      Float?
  amount          Float? // grand total = baseFare + addonTotal, frozen at check-in/out
  amountCollected Float?
  amountPaidGuest Float?
  addons          Json?
  checkoutAddons  Json?

  status OpsTripStatus @default(SCHEDULED)
  notes  String?

  // Ground-staff auto-assignment ("finger-cross" round robin — see
  // pickLeastLoadedOpsAgent in agentAssignment.ts), reassignable by an admin.
  assignedAgentId String?
  agent           User?   @relation("AgentOpsTrips", fields: [assignedAgentId], references: [id])

  // Identity verification captured at handover. OpsTrip customers have no User
  // account (see model doc comment above), so this lives on the trip itself —
  // mirrors the "Velosta Card" pattern: never store the full Aadhaar number,
  // only a masked photo the agent captures, or a DigiLocker-verified name/
  // address/last-4 fetched through the same Setu integration kyc.routes.ts
  // already uses for renter/host KYC (see setuService.ts).
  idVerificationMethod   String? // MASKED_PHOTO | DIGILOCKER
  maskedIdPhotoUrl       String?
  dlFrontUrl             String?
  dlBackUrl              String?
  dlNumber               String?
  digilockerRequestId    String?
  digilockerStatus       String? // unauthenticated | authenticated
  digilockerVerifiedName String?
  digilockerAddress      String?
  digilockerAadhaarLast4 String?
  saveIdentityToVault    Boolean @default(false)

  customerSignatureUrl String?
  vehiclePhotoUrls     String[] @default([])
  customerDecision     String?

  depositAmount      Float?
  depositCollected   Float?
  depositPaymentMode String? // CASH | ONLINE
  depositRefundedAt  DateTime?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images         OpsTripImage[]
  invoices       OpsInvoice[]
  cashLogEntries CashLogEntry[]

  @@index([carId])
  @@index([status])
  @@index([assignedAgentId])
}

// Reusable verified-identity cache, keyed by phone number — lets an agent skip
// re-capturing ID proof for a repeat walk-in customer ("Add to Vault" at
// checkout below). Deliberately not tied to a User (walk-ins have none); a
// later real signup can't retroactively claim this record automatically.
model CustomerVaultEntry {
  id                     String   @id @default(uuid())
  phoneNumber            String   @unique
  fullName               String?
  idVerificationMethod   String?
  maskedIdPhotoUrl       String?
  dlFrontUrl             String?
  dlBackUrl              String?
  dlNumber               String?
  digilockerVerifiedName String?
  digilockerAddress      String?
  digilockerAadhaarLast4 String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum CashLogType {
  CASH_IN
  CASH_OUT
}

// Ground-staff cash counter — the running cash-in/cash-out ledger an agent
// reconciles against what's physically in the drawer at end of shift.
model CashLogEntry {
  id        String      @id @default(uuid())
  agentId   String
  agent     User        @relation(fields: [agentId], references: [id])
  type      CashLogType
  amount    Float
  category  String // Booking Collection | Deposit Collected | Deposit Refund | Fuel | Maintenance | Salary | Other
  note      String?
  tripId    String?
  trip      OpsTrip?    @relation(fields: [tripId], references: [id])
  createdAt DateTime    @default(now())

  @@index([agentId, createdAt])
  @@index([tripId])
}

model OpsTripImage {
  id        String   @id @default(uuid())
  tripId    String
  trip      OpsTrip  @relation(fields: [tripId], references: [id])
  url       String
  createdAt DateTime @default(now())

  @@index([tripId])
}

enum OpsInvoiceType {
  RENTAL
  SERVICE
}

enum OpsInvoiceStatus {
  DRAFT
  PENDING
  SENT
  PAID
}

// Two invoice types sharing one model (RENTAL ties to an OpsTrip, SERVICE ties
// to a ServiceRequest) — matches the real system's "same branding/format, two
// document types" behavior. serviceChargePct/serviceCharge/netToOwner are
// frozen onto the row at creation from the admin-editable Setting
// fleet_facilitation_fee_pct — later config changes don't retroactively alter
// already-issued invoices, matching real production behavior.
model OpsInvoice {
  id            String          @id @default(uuid())
  invoiceNumber String          @unique
  type          OpsInvoiceType
  tripId        String?
  trip          OpsTrip?        @relation(fields: [tripId], references: [id])
  serviceId     String?
  service       ServiceRequest? @relation(fields: [serviceId], references: [id])

  amount           Float
  serviceChargePct Float
  serviceCharge    Float
  netToOwner       Float
  status           OpsInvoiceStatus @default(SENT)
  issuedAt         DateTime         @default(now())

  // GST — computed at issue time from the admin-configurable company_gstin /
  // default_gst_rate Settings, frozen onto the row like serviceChargePct
  // (a later rate change shouldn't alter an already-issued invoice). Split
  // into CGST+SGST when placeOfSupply matches the company's home state
  // (intra-state), IGST otherwise — Ziyam is Bengaluru-only today so every
  // real invoice is intra-state, but the split is modeled correctly for
  // when that changes.
  placeOfSupply String?
  gstRate       Float?
  cgstAmount    Float?
  sgstAmount    Float?
  igstAmount    Float?

  customerName   String?
  customerMobile String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  payments OpsPayment[]

  @@index([tripId])
  @@index([serviceId])
}

enum OpsPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model OpsPayment {
  id           String           @id @default(uuid())
  invoiceId    String
  invoice      OpsInvoice       @relation(fields: [invoiceId], references: [id])
  method       String? // Cash | UPI | Card | Bank Transfer — see fleet_payment_modes Setting
  transferDate DateTime?
  reference    String?
  notes        String?
  amount       Float
  status       OpsPaymentStatus @default(PENDING)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

enum ItineraryUnlockStatus {
  PENDING_PAYMENT
  PAID
  FAILED
}

// A one-off ₹49 AI-generated road-trip itinerary purchase — deliberately not
// tied to a User (no signup required for this impulse-buy homepage teaser,
// same "walk-in, plain contact fields" pattern as OpsTrip). generatedContent
// is produced once via aiService.generateChatReply and cached on the row so
// a customer never pays twice to re-view the same itinerary.
model ItineraryUnlock {
  id               String                @id @default(uuid())
  destination      String // "Ooty" | "Coorg" | "Chikmagalur" | "Gokarna"
  customerName     String
  customerEmail    String
  customerPhone    String
  amount           Float                 @default(49)
  paymentIntentId  String?               @unique // PayU txnid
  status           ItineraryUnlockStatus @default(PENDING_PAYMENT)
  generatedContent String?
  createdAt        DateTime              @default(now())

  @@index([status])
}

// Traceability for admin mutations (suspend, feature, refund, etc).
model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}
