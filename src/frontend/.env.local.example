NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_MIXPANEL_TOKEN=""        # Mixpanel Project Settings > Project Token (renter/host app)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""   # Google Cloud Console — restrict by HTTP referrer to your deployed domains
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""    # Google Cloud Console > Google Maps Platform > Map Management — required for gmp-advanced-marker

# Google sign-in on the login page ("Continue with Google") — leave both
# blank to hide that button entirely; nothing else depends on these.
NEXT_PUBLIC_SUPABASE_URL=""           # Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=""      # Project Settings > API > anon public key

# Push notifications (FCM) — leave all blank to hide/disable push entirely.
# Values come from Firebase Console > Project Settings > General > Your apps
# (Web app config). VAPID key is under Cloud Messaging > Web Push certificates.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
