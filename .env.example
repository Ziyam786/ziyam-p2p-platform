# --- Database ---
DATABASE_URL="postgresql://ziyam_user:CHANGE_ME@localhost:5432/ziyam_db?schema=public"

# --- App ---
PORT=5000
CLIENT_URL="https://ziyam.in"
SERVER_URL="https://api.ziyam.in"   # this server's own public URL — PayU redirects here after checkout
NODE_ENV=development

# --- Auth ---
JWT_SECRET="CHANGE_ME_to_a_long_random_string"
JWT_EXPIRES_IN="30d"

# --- Admin app origin (for CORS) ---
ADMIN_URL="http://localhost:3001"

# --- Standalone ground-staff Agent app origin (for CORS) — see src/agent ---
AGENT_URL="http://localhost:3002"

# --- AI support chatbot (Anthropic Claude) ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"

# --- Payments (PayU) ---
PAYMENT_PROVIDER=payu
PAYU_MODE=test                     # test | live — controls which PayU endpoint we POST to
PAYU_KEY=""                        # Developers > API Keys > "key"
PAYU_SALT=""                       # Developers > API Keys > "Salt"
PAYU_CLIENT_ID=""                  # Developers > API Keys > "Client ID" (reserved for future OAuth-based APIs)
PAYU_CLIENT_SECRET=""              # Developers > API Keys > "Client Secret"
PAYMENT_WEBHOOK_SECRET=""

# --- Payout policy ---
PLATFORM_COMMISSION_PERCENTAGE=0.30
HOST_PAYOUT_PERCENTAGE=0.70
PAYOUT_SETTLEMENT_HOURS=24         # N+1

# --- KYC ---
KYC_PROVIDER=digilocker            # digilocker | aadhaar-xml
KYC_API_KEY=""

# --- Sandbox (sandbox.co.in) — Aadhaar eKYC + bank penny-drop verification ---
SANDBOX_MODE=test                  # test | live
SANDBOX_API_KEY=""                 # Console > Settings > API Keys
SANDBOX_API_SECRET=""              # shown once at key creation — regenerate if lost

# --- Setu (bridge.setu.co) — DigiLocker KYC + Aadhaar eSign ---
SETU_MODE=test                             # test | live
SETU_CLIENT_ID=""                          # Bridge > API Keys (shared across products)
SETU_CLIENT_SECRET=""
SETU_DIGILOCKER_PRODUCT_INSTANCE_ID=""     # Bridge > DigiLocker product > Product details
SETU_ESIGN_PRODUCT_INSTANCE_ID=""          # Bridge > eSign product > Product details

# --- Arya.ai (Aurionpro) — document verification, ping.arya.ai ---
# Each is a separate product with its own token from the dashboard.
ARYA_KYC_TOKEN=""            # KYC doc extraction (driving license verification)
ARYA_RC_TOKEN=""             # Vehicle RC Verification (automated RC cross-check)
ARYA_IMAGE_QUALITY_TOKEN=""  # image-quality-checker (pre-check before extraction calls)

# --- Supabase (Google sign-in — see /auth/oauth/supabase, verified via
# @supabase/server/core's verifyCredentials against the JWKS below) ---
SUPABASE_URL=""                    # Project Settings > API > Project URL
SUPABASE_PUBLISHABLE_KEY=""        # Project Settings > API Keys > publishable key (sb_publishable_...)
# Only needed if something later calls createAdminClient()/uses auth:'secret'.
SUPABASE_SECRET_KEY=""             # Project Settings > API Keys > secret key (server-only, never expose client-side)
SUPABASE_JWKS_URL=""               # <SUPABASE_URL>/auth/v1/.well-known/jwks.json

# --- Telematics / IoT ---
TELEMATICS_GATEWAY_URL="https://api.telematics-provider.com/v1"
TELEMATICS_API_KEY=""

# --- MSG91 — SMS + WhatsApp confirmations ---
# Real transactional SMS in India requires a separate DLT-registered template
# per distinct message — register one for OTP and one for booking-confirmed
# in the MSG91 dashboard first. Until this is configured, sends are logged,
# not delivered (see smsService.ts).
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="ZIYAM"
MSG91_OTP_TEMPLATE_ID=""
MSG91_BOOKING_CONFIRMED_TEMPLATE_ID=""
MSG91_WHATSAPP_NUMBER=""           # WhatsApp Business API > Manage Numbers > your integrated number

# --- Resend — transactional email ---
RESEND_API_KEY=""                  # dashboard.resend.com > API Keys
EMAIL_FROM="Ziyam <noreply@ziyam.in>"   # must be on a domain verified in Resend

# --- Firebase Admin — sends FCM push notifications (server-side only; the
# public web config lives in src/frontend/.env.local, NEXT_PUBLIC_FIREBASE_*).
# Paste the full one-line JSON from Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Leave blank to disable push
# sending (falls back to a console.log stub — see firebaseAdmin.ts).
FIREBASE_SERVICE_ACCOUNT_JSON=''

# --- Redis (queues / caching) ---
REDIS_URL="redis://localhost:6379"
