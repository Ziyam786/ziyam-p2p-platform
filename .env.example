# --- Database ---
DATABASE_URL="postgresql://ziyam_user:CHANGE_ME@localhost:5432/ziyam_db?schema=public"

# --- App ---
PORT=5000
CLIENT_URL="https://ziyam.in"
SERVER_URL="https://api.ziyam.in"   # this server's own public URL — PayU redirects here after checkout
NODE_ENV=development

# --- Auth ---
JWT_SECRET="CHANGE_ME_to_a_long_random_string"
JWT_EXPIRES_IN="30d"

# --- Admin app origin (for CORS) ---
ADMIN_URL="http://localhost:3001"

# --- Standalone ground-staff Agent app origin (for CORS) — see src/agent ---
AGENT_URL="http://localhost:3002"

# --- AI support chatbot (Anthropic Claude) ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"

# --- Payments (PayU) ---
PAYMENT_PROVIDER=payu
PAYU_MODE=test                     # test | live — controls which PayU endpoint we POST to
PAYU_KEY=""                        # Developers > API Keys > "key"
PAYU_SALT=""                       # Developers > API Keys > "Salt"
PAYU_CLIENT_ID=""                  # Developers > API Keys > "Client ID" (reserved for future OAuth-based APIs)
PAYU_CLIENT_SECRET=""              # Developers > API Keys > "Client Secret"
PAYMENT_WEBHOOK_SECRET=""

# --- Payout policy ---
PLATFORM_COMMISSION_PERCENTAGE=0.30
HOST_PAYOUT_PERCENTAGE=0.70
PAYOUT_SETTLEMENT_HOURS=24         # N+1

# --- KYC ---
KYC_PROVIDER=digilocker            # digilocker | aadhaar-xml
KYC_API_KEY=""

# --- Sandbox (sandbox.co.in) — Aadhaar eKYC + bank penny-drop verification ---
SANDBOX_MODE=test                  # test | live
SANDBOX_API_KEY=""                 # Console > Settings > API Keys
SANDBOX_API_SECRET=""              # shown once at key creation — regenerate if lost

# --- Setu (bridge.setu.co) — DigiLocker KYC + Aadhaar eSign ---
SETU_MODE=test                             # test | live
SETU_CLIENT_ID=""                          # Bridge > API Keys (shared across products)
SETU_CLIENT_SECRET=""
SETU_DIGILOCKER_PRODUCT_INSTANCE_ID=""     # Bridge > DigiLocker product > Product details
SETU_ESIGN_PRODUCT_INSTANCE_ID=""          # Bridge > eSign product > Product details

# --- Supabase (Google sign-in only — see /auth/oauth/supabase) ---
SUPABASE_URL=""                    # Project Settings > API > Project URL
SUPABASE_ANON_KEY=""               # Project Settings > API > anon public key

# --- Telematics / IoT ---
TELEMATICS_GATEWAY_URL="https://api.telematics-provider.com/v1"
TELEMATICS_API_KEY=""

# --- Redis (queues / caching) ---
REDIS_URL="redis://localhost:6379"
