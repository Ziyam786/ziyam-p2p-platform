{
  "name": "ziyam-p2p-platform",
  "version": "0.1.0",
  "description": "ZiyamSelfDrive - P2P self-drive car rental platform (fleet operators, self-hosts, 70/30 split, N+1 payouts)",
  "main": "dist/backend/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/backend/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "verify:no-double-booking": "ts-node --transpile-only src/backend/scripts/verify-no-double-booking.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.18.0",
    "@supabase/server": "^1.4.1",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
